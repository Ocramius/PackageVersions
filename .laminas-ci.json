{
  "extensions": [
    "pcov"
  ],
  "ini": [
    "memory_limit=-1"
  ],
  "exclude": [
    {"name": "Infection [8.4, locked]"}
  ],
  "additional_checks": [
    {
      "name": "Infection (with PCOV)",
      "job": {
        "php": "8.4",
        "dependencies": "locked",
        "command": "./vendor/bin/roave-infection-static-analysis-plugin"
      }
    }
  ],
  "ignore_php_platform_requirements": {
    "8.5": true
  }
}